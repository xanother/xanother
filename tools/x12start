# x12start - one command to bring up an x12 session, in the spirit of
# startx. it runs the x12 server and the x12 x11 bridge, then hands the
# display to a session just like xorg hands it to ~/.xinitrc:
#
#   x12start                      runs ~/.x12initrc (or ~/.xinitrc)
#   x12start fvwm3                runs that command as the session
#   x12start -d :92 -s 1600x900 i3
#
# the session script is a plain shell script like ~/.xinitrc: helper
# programs go to the background with & and the window manager comes
# last with exec, so the session lives exactly as long as the manager.
# when it exits the servers come down with it.

set -u

usage() {
    cat <<'EOF'
usage: x12start [options] [command ...]
  -d DISPLAY    x display for the bridge (default :90)
  -s WxH        canvas size (default 1280x800)
  -sock ADDR    x12 listen address (default /tmp/x12-<uid>.sock)
  -ppm PATH     write the frame to a ppm after every draw
  -kms          output to real drm instead of the headless canvas
  -gpu          blend on the gl canvas
  -grants LIST  comm names the isolation lets see the window tree
  -h            this help

with no command the session comes from ~/.x12initrc, falling back to
~/.xinitrc. with neither a command nor a config, x12start writes a
starter ~/.x12initrc and runs it.

with neither -ppm nor -kms the picture goes to the real drm screen
when there is one and falls back to a ppm file when there is not -
the path is printed at startup.
EOF
    exit "${1:-0}"
}

here=$(dirname "$0")
build=${X12_BUILD:-"$here/../build"}
server=${X12_SERVER:-"$build/x12-server"}
bridge=${X12_BRIDGE:-"$build/vendor/xserver/build/hw/x12/Xx12"}

display=:90
size=1280x800
sock=/tmp/x12-$(id -u).sock
ppm=
kms=no
gpu=no
grants=${X12_BRIDGE_GRANTS:-xwininfo,xdotool,xrandr}

while [ $# -gt 0 ]; do
    case $1 in
    -d)      [ $# -ge 2 ] || usage 1; display=$2; shift 2;;
    -s)      [ $# -ge 2 ] || usage 1; size=$2; shift 2;;
    -sock)   [ $# -ge 2 ] || usage 1; sock=$2; shift 2;;
    -ppm)    [ $# -ge 2 ] || usage 1; ppm=$2; shift 2;;
    -grants) [ $# -ge 2 ] || usage 1; grants=$grants,$2; shift 2;;
    -kms)    kms=yes; shift;;
    -gpu)    gpu=yes; shift;;
    -h)      usage 0;;
    --)      shift; break;;
    -*)      echo "x12start: unknown option $1" >&2; usage 1;;
    *)       break;;
    esac
done

[ -x "$server" ] || { echo "x12start: no $server, run sh tools/build.sh" >&2; exit 1; }
[ -x "$bridge" ] || { echo "x12start: no $bridge, run sh tools/bridge_build.sh" >&2; exit 1; }

# the x server compiles its keymap with xkbcomp and dies without it
if [ ! -x /usr/bin/xkbcomp ] && ! command -v xkbcomp >/dev/null 2>&1; then
    echo "x12start: no xkbcomp, the x keyboard compiler" >&2
    echo "x12start: install x11-xkb-utils (deb) or xorg-xkbcomp (arch)" >&2
    exit 1
fi

w=${size%x*}
h=${size#*x}
num=${display#:}
num=${num%%.*}

[ -e "/tmp/.X11-unix/X$num" ] && {
    echo "x12start: display $display is busy, pick another with -d" >&2
    exit 1
}

# the starter config keeps the xinitrc recipes next to the one line
# that picks the window manager
if [ $# -eq 0 ] && [ ! -f "$HOME/.x12initrc" ] && [ ! -f "$HOME/.xinitrc" ]; then
    cat > "$HOME/.x12initrc" <<'EOF'
# the x12 session, in the spirit of ~/.xinitrc: helpers go to the
# background with &, the window manager comes last with exec.

xsetroot -solid "#204060" &

# pick your session:
exec xterm
# exec fvwm3
# exec i3
# exec dbus-run-session -- sh -c 'kwin_x11 & plasmashell & wait'
EOF
    echo "x12start: wrote ~/.x12initrc, edit it to pick your window manager"
fi

server_pid=
bridge_pid=
cleanup() {
    [ -n "$bridge_pid" ] && kill "$bridge_pid" 2>/dev/null
    [ -n "$server_pid" ] && kill "$server_pid" 2>/dev/null
    sleep 1
    [ -n "$bridge_pid" ] && kill -9 "$bridge_pid" 2>/dev/null
    [ -n "$server_pid" ] && kill -9 "$server_pid" 2>/dev/null
    rm -f "/tmp/.X$num-lock" "/tmp/.X11-unix/X$num"
    case $sock in
    tcp:*|tls:*) ;;
    *) rm -f "$sock";;
    esac
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

# where the picture goes: the flags decide, otherwise the real screen
# when there is drm and a ppm we can watch when there is not
gl=
[ "$gpu" = yes ] && gl=--gpu
frame=
run_kms=no
auto_kms=no
if [ "$kms" = yes ]; then
    run_kms=yes
    frame=$ppm
elif [ -n "$ppm" ]; then
    frame=$ppm
elif [ -e /dev/dri/card0 ]; then
    run_kms=yes
    auto_kms=yes
else
    frame=${TMPDIR:-/tmp}/x12-$(id -u).ppm
fi

# the headless backend serves every transport, --kms swaps in real drm.
# the first attempt can lose the drm race to a login manager - that is
# not fatal, the ppm is
attempt=1
while :; do
    if [ "$run_kms" = yes ] && [ -n "$frame" ]; then
        "$server" "$sock" --width "$w" --height "$h" $gl --kms --ppm "$frame" &
    elif [ "$run_kms" = yes ]; then
        "$server" "$sock" --width "$w" --height "$h" $gl --kms &
    elif [ -n "$frame" ]; then
        "$server" "$sock" --width "$w" --height "$h" $gl --ppm "$frame" &
    else
        "$server" "$sock" --width "$w" --height "$h" $gl &
    fi
    server_pid=$!

    # a unix socket is a file we can wait on, the network transports
    # are listening the moment the process starts. a dead pid means
    # the startup failed - stop waiting and say so
    up=no
    tries=0
    while [ "$tries" -lt 10 ]; do
        kill -0 "$server_pid" 2>/dev/null || break
        case $sock in
        tcp:*|tls:*) up=yes; break;;
        esac
        [ -e "$sock" ] && { up=yes; break; }
        sleep 1
        tries=$((tries + 1))
    done
    [ "$up" = yes ] && break

    if [ "$auto_kms" = yes ] && [ "$attempt" -eq 1 ]; then
        echo "x12start: no drm output, falling back to a ppm" >&2
        kill -9 "$server_pid" 2>/dev/null
        server_pid=
        case $sock in
        tcp:*|tls:*) ;;
        *) rm -f "$sock";;
        esac
        run_kms=no
        auto_kms=no
        frame=${TMPDIR:-/tmp}/x12-$(id -u).ppm
        attempt=2
        continue
    fi

    echo "x12start: server failed to start (errors above)" >&2
    [ "$kms" = yes ] && echo "x12start: a login manager may own the drm, try -ppm" >&2
    exit 1
done

# the bridge is the x server the session talks to
X12_BRIDGE_SOCKET=$sock X12_BRIDGE_GRANTS=$grants \
X12_BRIDGE_WIDTH=$w X12_BRIDGE_HEIGHT=$h \
    "$bridge" "$display" -ac -noreset &
bridge_pid=$!

# the x socket appears before the server finishes initializing, so a
# display query is the readiness check when x11-utils is around
up=no
tries=0
while [ "$tries" -lt 10 ]; do
    kill -0 "$bridge_pid" 2>/dev/null || break
    kill -0 "$server_pid" 2>/dev/null || break
    if command -v xdpyinfo >/dev/null 2>&1; then
        xdpyinfo -display "$display" >/dev/null 2>&1 && { up=yes; break; }
    else
        [ -e "/tmp/.X11-unix/X$num" ] && { up=yes; break; }
    fi
    sleep 1
    tries=$((tries + 1))
done
[ "$up" = yes ] || {
    echo "x12start: bridge failed to start (errors above)" >&2
    [ "$kms" = yes ] && echo "x12start: a login manager may own the drm, try -ppm" >&2
    exit 1
}

note=
[ "$run_kms" = yes ] && note=", on drm"
[ -n "$frame" ] && note="$note, frame in $frame"
echo "x12start: session on $display (x12 on $sock)$note"

DISPLAY=:$num
export DISPLAY

status=0
if [ $# -gt 0 ]; then
    "$@" || status=$?
elif [ -f "$HOME/.x12initrc" ]; then
    sh "$HOME/.x12initrc" || status=$?
else
    sh "$HOME/.xinitrc" || status=$?
fi
exit $status
